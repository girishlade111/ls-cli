{
  "name": "ladestack",
  "version": "0.1.0",
  "description": "LS CLI - A CLI tool for the LadeStack brand",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "ladestack": "./dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsup",
    "postbuild": "chmod +x dist/index.js",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write src/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ladestack",
    "cli",
    "ai",
    "developer-tools",
    "workspace"
  ],
  "author": "",
  "license": "MIT",
  "_comments": {
    "ink": "React for CLI — core UI framework",
    "ink-spinner": "Loading spinner component",
    "ink-text-input": "Text input component",
    "ink-select-input": "Arrow key selection dropdown",
    "react": "Required peer dep for Ink",
    "dotenv": "Environment variable loading",
    "commander": "CLI argument/flag parser",
    "chalk": "Terminal string styling",
    "ora": "Elegant terminal spinners (fallback)",
    "xlsx": "Excel/CSV file generation",
    "node-fetch": "HTTP client for NIM API calls",
    "fs-extra": "Enhanced file system operations",
    "marked": "Markdown parser for terminal preview",
    "marked-terminal": "Render markdown in terminal",
    "cli-table3": "Table rendering in terminal",
    "gradient-string": "Gradient text for branding",
    "boxen": "Boxes in terminal for UI panels",
    "figlet": "ASCII art text generation",
    "typescript": "TypeScript language",
    "tsx": "Run TypeScript directly for dev",
    "tsup": "Build/bundle tool",
    "@types/react": "TypeScript definitions for react",
    "@types/node": "TypeScript definitions for node",
    "@types/fs-extra": "TypeScript definitions for fs-extra",
    "@types/figlet": "TypeScript definitions for figlet",
    "@typescript-eslint/parser": "TypeScript ESLint parser",
    "@typescript-eslint/eslint-plugin": "TypeScript ESLint plugin",
    "eslint": "Code linting",
    "prettier": "Code formatting"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "figlet": "^1.11.0",
    "fs-extra": "^11.3.5",
    "gradient-string": "^3.0.0",
    "ink": "^7.0.3",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^18.0.3",
    "marked-terminal": "^7.3.0",
    "node-fetch": "^3.3.2",
    "ora": "^9.4.0",
    "react": "^19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/figlet": "^1.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  }
}
